pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Run Application') {
            steps {
                bat '"C:\\Users\\HP\\AppData\\Local\\Programs\\Python\\Python315\\python.exe" app.py'
            }
        }

        stage('Run Tests') {
            steps {
                bat '"C:\\Users\\HP\\AppData\\Local\\Programs\\Python\\Python315\\python.exe" test.py'
            }
        }

        stage('Build') {
            steps {
                echo 'Build completed successfully'
            }
        }
    }

    post {
        success {
            echo 'Jenkins Build Successful'
        }
        failure {
            echo 'Jenkins Build Failed'
        }
    }
}
